{
  "$schema": "https://jsonschema-12/draft/2020-12/schema",
  "$id": "phase10-redteam-report-v1",
  "title": "Phase 10D red-team report (phase10-redteam-report-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "source_state",
    "image_ids",
    "dependencies",
    "policy_versions",
    "seed",
    "fixture_sha256",
    "fixtures",
    "metrics",
    "timestamps",
    "cleanup_complete",
    "non_acceptance",
    "acceptance",
    "production_fingerprints"
  ],
  "properties": {
    "schema_version": {
      "const": "phase10-redteam-report-v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "pattern": "^redteam-"
      }
    },
    "source_state": {
      "$ref": "#/$defs/SourceState"
    },
    "image_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "migrate"
      ],
      "properties": {
        "api": {
          "type": "string",
          "minLength": 1
        },
        "migrate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "seed": {
      "const": 42
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ScenarioResult"
      }
    },
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "completed_at"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "completed_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cleanup_complete": {
      "type": "boolean"
    },
    "non_acceptance": {
      "type": "boolean"
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thresholds_passed",
        "failure_codes"
      ],
      "properties": {
        "thresholds_passed": {
          "type": "boolean"
        },
        "failure_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "production_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "per_fixture",
        "post_cleanup"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/Fingerprint"
        },
        "per_fixture": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fixture_id",
              "mode",
              "sha256"
            ],
            "properties": {
              "fixture_id": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "disabled",
                  "enabled"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "post_cleanup": {
          "$ref": "#/$defs/Fingerprint"
        }
      }
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "policy_versions": {
      "$ref": "#/$defs/policy_versions"
    }
  },
  "$defs": {
    "ShaOrPath": {
      "type": "string",
      "minLength": 1
    },
    "Labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "source_context_sha256",
        "source_dirty"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_context_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_dirty": {
          "enum": [
            "true",
            "false"
          ]
        }
      }
    },
    "SourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit_sha",
        "dirty",
        "porcelain_sha256",
        "manifest_sha256",
        "delivery_tree_sha256",
        "image_context_sha256",
        "api_labels",
        "migrate_labels"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "porcelain_sha256": {
          "$ref": "#/$defs/ShaOrPath"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/ShaOrPath"
        },
        "delivery_tree_sha256": {
          "$ref": "#/$defs/ShaOrPath"
        },
        "image_context_sha256": {
          "$ref": "#/$defs/ShaOrPath"
        },
        "api_labels": {
          "$ref": "#/$defs/Labels"
        },
        "migrate_labels": {
          "$ref": "#/$defs/Labels"
        }
      }
    },
    "CountRatio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator",
        "value",
        "denominator_zero"
      ],
      "properties": {
