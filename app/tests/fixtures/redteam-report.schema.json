          "type": "string",
          "minLength": 1
        },
        "chunk_fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "sql_document_id": {
          "type": "integer",
          "minimum": 1
        },
        "sql_chunk_id": {
          "type": "integer",
          "minimum": 1
        },
        "is_poisoned": {
          "type": "boolean"
        },
        "required_clean": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PathRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "selected",
        "evidence_fixture_ids",
        "contains_poisoned_evidence"
      ],
      "properties": {
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "selected": {
          "type": "boolean"
        },
        "evidence_fixture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contains_poisoned_evidence": {
          "type": "boolean"
        }
      }
    },
    "EvaluatorCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "result"
      ],
      "properties": {
        "type": {
          "enum": [
            "poisoned_chunk_selected",
            "answer_contains_literal",
            "graph_path_contains_poisoned_evidence",
            "unsafe_answer_returned",
            "control_not_triggered"
          ]
        },
        "result": {
          "type": "boolean"
        },
        "poisoned_document_id": {
          "type": "string"
        },
        "literal": {
          "type": "string"
        },
        "control_id": {
          "type": "string"
        }
      },
      "$comment": "The type-specific parameter must match the hashed corpus evaluator; validate_redteam_report enforces the exact parameter set per type (closed union semantics live in the validator)."
    },
    "Observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "poisoned_chunk_selected",
            "answer_contains_literal",
            "graph_path_contains_poisoned_evidence",
            "unsafe_answer_returned",
            "control_not_triggered"
          ]
        },
        "target_chunk_fixture_id": {
          "type": "string"
        },
        "selected_chunk_fixture_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "literal_sha256": {
          "type": "string"
        },
        "returned_marker_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_marker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "match_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "match_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "poisoned_evidence_fixture_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected_path_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected_evidence_fixture_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
