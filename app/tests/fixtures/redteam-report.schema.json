    "NumericRatio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator",
        "value",
        "denominator_zero"
      ],
      "properties": {
        "numerator": {
          "type": "number"
        },
        "denominator": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "type": "number"
        },
        "denominator_zero": {
          "type": "boolean"
        }
      }
    },
    "LatencySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "p50_ms",
        "p95_ms"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "LatencyMethodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "warmups_per_fixture",
        "measured_repetitions_per_fixture",
        "percentile_method"
      ],
      "properties": {
        "clock": {
          "const": "perf_counter_ns"
        },
        "warmups_per_fixture": {
          "const": 3
        },
        "measured_repetitions_per_fixture": {
          "const": 10
        },
        "percentile_method": {
          "const": "nearest_rank"
        }
      }
    },
    "ModeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack_success_rate",
        "poisoned_context_share",
        "clean_retrieval_recall",
        "false_positive_rate",
        "graph_path_contamination",
        "blocked_generation_count",
        "unsafe_answers_after_block",
        "latency"
      ],
      "properties": {
        "attack_success_rate": {
          "$ref": "#/$defs/CountRatio"
        },
        "poisoned_context_share": {
          "$ref": "#/$defs/CountRatio"
        },
        "clean_retrieval_recall": {
          "$ref": "#/$defs/CountRatio"
        },
        "false_positive_rate": {
          "$ref": "#/$defs/CountRatio"
        },
        "graph_path_contamination": {
          "$ref": "#/$defs/CountRatio"
        },
        "blocked_generation_count": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_answers_after_block": {
          "$ref": "#/$defs/CountRatio"
        },
        "latency": {
          "$ref": "#/$defs/LatencySummary"
        }
      }
    },
    "ComparisonMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_attack_reduction",
        "p50_latency_overhead",
        "p95_latency_overhead"
      ],
      "properties": {
        "relative_attack_reduction": {
          "$ref": "#/$defs/NumericRatio"
        },
        "p50_latency_overhead": {
          "$ref": "#/$defs/NumericRatio"
        },
        "p95_latency_overhead": {
          "$ref": "#/$defs/NumericRatio"
        }
      }
    },
    "Metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodology",
        "disabled",
        "enabled",
        "comparison"
      ],
      "properties": {
        "methodology": {
          "$ref": "#/$defs/LatencyMethodology"
        },
        "disabled": {
          "$ref": "#/$defs/ModeMetrics"
        },
        "enabled": {
          "$ref": "#/$defs/ModeMetrics"
        },
        "comparison": {
          "$ref": "#/$defs/ComparisonMetrics"
        }
      }
    },
    "ControlResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "would_trigger",
        "enforced",
        "outcome"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "would_trigger": {
          "type": "boolean"
        },
        "enforced": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CandidateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_fixture_id",
        "chunk_fixture_id",
        "sql_document_id",
        "sql_chunk_id",
        "is_poisoned",
        "required_clean",
        "selected",
        "decision",
        "reason_codes"
