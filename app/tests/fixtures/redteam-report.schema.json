        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "denominator_zero": {
          "type": "boolean"
        }
      },
      "$comment": "numerator <= denominator is encoded for denominators 0..32 via if/then branches (the region this report's counted ratios occupy); validate_redteam_report enforces the general invariant plus value == round(numerator/denominator, 6) with 0.0 when denominator_zero.",
      "allOf": [
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "numerator": {
                "maximum": 1
              }
            }
          }
        },
