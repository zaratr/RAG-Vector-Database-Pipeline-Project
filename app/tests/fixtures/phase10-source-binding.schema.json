{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-pipeline.local/phase10-source-binding-v1.schema.json",
  "title": "Phase 10 source binding (phase10-source-binding-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_sha256",
    "branch",
    "commit",
    "dirty",
    "porcelain_hash",
    "delivery_tree_sha256",
    "image_context_sha256",
    "services"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "phase10-source-binding-v1" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "branch": { "type": "string" },
    "commit": { "type": "string" },
    "dirty": { "type": "boolean" },
    "porcelain_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "delivery_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "image_context_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "migrate"],
      "properties": {
        "api": { "$ref": "#/$defs/service_binding" },
        "migrate": { "$ref": "#/$defs/service_binding" }
      }
    }
  },
  "$defs": {
    "service_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_id", "labels"],
      "properties": {
        "image_id": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "org.opencontainers.image.revision",
            "org.opencontainers.image.source-context-sha256",
            "org.opencontainers.image.source-dirty"
          ],
          "properties": {
            "org.opencontainers.image.revision": { "type": "string" },
            "org.opencontainers.image.source-context-sha256": { "type": "string" },
            "org.opencontainers.image.source-dirty": { "type": "string" }
          }
        }
      }
    }
  }
}
