{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-pipeline.local/phase10-command-ledger-v1.schema.json",
  "title": "Phase 10 command ledger (phase10-command-ledger-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gate_id", "steps"],
  "properties": {
    "schema": { "type": "string", "const": "phase10-command-ledger-v1" },
    "gate_id": {
      "type": "string",
      "enum": ["phase10a", "phase10b", "phase10c", "phase10d", "documentation", "final"]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "secret_scan_passed"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "kind": {
          "type": "string",
          "enum": ["subprocess", "assertion", "internal"]
        },
        "argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assertion_id": { "type": "string" },
        "phase": {
          "type": "string",
          "enum": ["primary", "restoration"]
        },
        "cwd": { "type": "string" },
        "start_utc": { "type": "string" },
        "end_utc": { "type": "string" },
        "exit_code": { "type": "integer" },
        "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stdout_byte_count": { "type": "integer", "minimum": 0 },
        "stderr_byte_count": { "type": "integer", "minimum": 0 },
        "output_artifact_path": { "type": "string" },
        "output_artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "secret_scan_passed": { "type": "boolean" },
        "secret_leak_detected": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "subprocess" } }, "required": ["kind"] },
          "then": { "required": ["argv"] }
        },
        {
          "if": { "properties": { "kind": { "const": "assertion" } }, "required": ["kind"] },
          "then": { "required": ["assertion_id"] }
        }
      ]
    }
  }
}
