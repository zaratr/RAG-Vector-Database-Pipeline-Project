{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-pipeline.local/phase10-gate-review-input-v1.schema.json",
  "title": "Phase 10 gate review input (phase10-gate-review-input-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "owner",
    "terminal_verdict",
    "findings",
    "utc_timestamp",
    "markdown_path",
    "markdown_sha256"
  ],
  "properties": {
    "gate_id": {
      "type": "string",
      "enum": ["phase10a", "phase10b", "phase10c", "phase10d", "documentation", "final"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "terminal_verdict": { "type": "string", "enum": ["APPROVED", "NOT APPROVED"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "actionable", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
          "actionable": { "type": "boolean" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "markdown_path": { "type": "string", "minLength": 1 },
    "markdown_sha256": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "description": "An APPROVED terminal verdict must not carry any actionable WARN finding.",
      "if": {
        "properties": { "terminal_verdict": { "const": "APPROVED" } },
        "required": ["terminal_verdict"]
      },
      "then": {
        "properties": {
          "findings": {
            "items": { "not": { "properties": { "actionable": { "const": true } }, "required": ["actionable"] } }
          }
        }
      }
    },
    {
      "description": "Any FAIL finding must force a NOT APPROVED terminal verdict.",
      "if": {
        "properties": {
          "findings": { "contains": { "properties": { "severity": { "const": "FAIL" } }, "required": ["severity"] } }
        },
        "required": ["findings"]
      },
      "then": { "properties": { "terminal_verdict": { "const": "NOT APPROVED" } } }
    }
  ]
}
