{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-pipeline.local/retrieval-calibration-v1.schema.json",
  "title": "Retrieval Calibration Corpus (retrieval-calibration-v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "embedding_model", "distance_metric", "top_k", "documents", "queries"],
  "properties": {
    "schema_version": {"type": "string", "const": "retrieval-calibration-v1"},
    "embedding_model": {"type": "string", "minLength": 1},
    "distance_metric": {"type": "string", "enum": ["l2"]},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 50},
    "documents": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "label", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "label": {"type": "string", "enum": ["clean", "poison"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "queries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "required_clean_ids", "poisoned_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "required_clean_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "poisoned_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
