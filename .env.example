# Two supported configuration recipes are documented below. Copy this file
# to .env and enable exactly one of them.
#
# 1. Hermetic/local: no external services, no model downloads. Hash-based
#    embeddings, in-process ephemeral Chroma, dummy LLM (or a local Ollama).
#    This is the environment the test suite runs green in from a clean
#    checkout; it is also the application-default configuration.
#
# 2. Production (Docker Compose): FastEmbed CLIP embeddings, Ollama/Gemma
#    for answers and graph extraction, and the vectordb Chroma server.

# ── Recipe 1: hermetic local development and tests ──────────────────────
# Uncomment for a service-free environment. These are already the
# application defaults, so an unset variable behaves the same.
#
#RAG_EMBEDDING_PROVIDER=local
#RAG_CHROMA_HOST=
#RAG_CHROMA_PERSIST_DIRECTORY=
#RAG_DATABASE_URL=sqlite:///./rag.db
#RAG_LLM_PROVIDER=dummy
# Graph extraction requires the Ollama provider; disable it when using the
# dummy or openai answer provider, or point the ollama settings below at a
# reachable server and keep RAG_LLM_PROVIDER=ollama instead.
#RAG_GRAPH_EXTRACTION_ENABLED=false

# ── Recipe 2: production (Docker Compose) ───────────────────────────────

# LLM provider: graph extraction and grounded generation use ollama/Gemma.
RAG_LLM_PROVIDER=ollama

# Ollama settings (used when RAG_LLM_PROVIDER=ollama)
RAG_LLM_BASE_URL=http://host.docker.internal:11434/v1
RAG_LLM_MODEL=gemma4

# Persisted GraphRAG extraction and bounded traversal
RAG_GRAPH_EXTRACTION_ENABLED=true
RAG_GRAPH_EXTRACTION_MODEL=gemma4
RAG_GRAPH_MAX_HOPS=2
# Extraction lease duration in seconds (60–3600). Default 600 (10 minutes).
RAG_EXTRACTION_LEASE_SECONDS=600

# Embedding provider: local (hash, default), fastembed (CLIP), or openai.
# Production uses fastembed for real 768-dimensional text/image embeddings.
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=jinaai/jina-clip-v1

# ChromaDB vector store
# Docker Compose: RAG_CHROMA_HOST=vectordb connects to the vectordb service
# For standalone: clear RAG_CHROMA_HOST and set RAG_CHROMA_PERSIST_DIRECTORY=/path/to/data
# For tests/dev only: clear RAG_CHROMA_HOST and leave RAG_CHROMA_PERSIST_DIRECTORY empty (ephemeral)
RAG_CHROMA_HOST=vectordb
RAG_CHROMA_PORT=8000
RAG_CHROMA_PERSIST_DIRECTORY=

# Database
RAG_DATABASE_URL=sqlite:////data/rag.db

# OpenAI (used when RAG_LLM_PROVIDER=openai or RAG_EMBEDDING_PROVIDER=openai)
RAG_OPENAI_API_KEY=***
